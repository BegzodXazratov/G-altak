{
  "functions": {
    "api/game.js": {
      "includeFiles": "api/_words.json"
    },
    "api/broadcast.js": {
      "maxDuration": 60
    },
    "api/admin.js": {
      "maxDuration": 60,
      "includeFiles": "api/_iq/**"
    },
    "api/iq.js": {
      "includeFiles": "api/_iq/**"
    },
    "api/bot.js": {
      "includeFiles": "api/_iq/**"
    },
    "api/setup.js": {
      "includeFiles": "api/_iq/**"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}